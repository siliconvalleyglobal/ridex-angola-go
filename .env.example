# RideX Angola — Environment Configuration
# Copy to .env and fill in your values

# ── Server ─────────────────────────────────────────────────────────────
APP_ENV=development
SERVER_PORT=8080
SERVER_READ_TIMEOUT_SEC=15
SERVER_WRITE_TIMEOUT_SEC=15
SERVER_SHUTDOWN_TIMEOUT_SEC=30
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
MAX_REQUEST_BODY_BYTES=1048576

# ── Database ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=ridex
DB_PASSWORD=ridex_secret
DB_NAME=ridex
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SEC=300

# ── PostGIS ────────────────────────────────────────────────────────────
# PostGIS is enabled via extension in the migration; no separate config needed.

# ── Valkey (Redis-protocol) ────────────────────────────────────────────
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0
VALKEY_POOL_SIZE=20

# ── JWT ────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-random-256-bit-secret
JWT_REFRESH_SECRET=change-this-to-a-different-random-256-bit-secret
JWT_ACCESS_EXPIRY_SEC=900
JWT_REFRESH_EXPIRY_SEC=604800

# ── SMS / OTP ──────────────────────────────────────────────────────────
# OTP delivery is not configured by the Go API. Select and implement a
# documented provider behind the OTPDelivery interface before enabling it.
SMS_PROVIDER=none
SMS_TEMPLATE=
OTP_EXPIRY_SEC=300
OTP_CODE_LENGTH=6

# ── Google Maps ────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_FALLBACK=enabled

# ── Payment Providers ──────────────────────────────────────────────────
PAYMENT_PROVIDER=appypay
# Options: appypay | vpos | both
# Optional generic HMAC secret for the provider-neutral webhook ledger endpoint.
# Leave unset until the selected provider's documented signature adapter is wired.
PAYMENT_WEBHOOK_SECRET=

# ── Payout Execution ───────────────────────────────────────────────────
# Options: (unset) | none | manual | http
#   manual  in-process executor; submissions recorded, no real money moves
#   http    banking provider over the documented REST contract:
#             POST /v1/payouts        {method, amountCents, driverId, reference}
#             GET  /v1/payouts/{ref}  -> {reference, status, message}
#           status: processing | completed | failed
# reference (the payout_requests id) must be honored as the idempotency key:
# resubmitting with the same reference must never pay twice.
PAYOUT_EXECUTOR=
PAYOUT_EXECUTOR_URL=
PAYOUT_EXECUTOR_API_KEY=

# ── AppyPay ────────────────────────────────────────────────────────────
APPYPAY_CLIENT_ID=your_appypay_client_id
APPYPAY_CLIENT_SECRET=your_appypay_client_secret
APPYPAY_BASE_URL=https://sandbox.appypay.co
APPYPAY_GPO_ENABLED=true

# ── VPOS ───────────────────────────────────────────────────────────────
VPOS_DEVELOPER_ID=your_vpos_developer_id
VPOS_API_KEY=your_vpos_api_key
VPOS_BASE_URL=https://api.vpos.ao
VPOS_WEBHOOK_SECRET=your_vpos_webhook_secret

# ── ProxyPay ───────────────────────────────────────────────────────────
PROXYPAY_BASE_URL=https://api.proxypay.co
PROXYPAY_API_KEY=your_proxypay_api_key

# ── Background Jobs (Asynq) ───────────────────────────────────────────
ASYNQ_CONSISTENCY_DIR=/tmp/asynq
ASYNQ_LOG_FORMAT=text
ASYNQ_MAX_PROCESSING_TIME_SEC=3600

# ── gRPC ───────────────────────────────────────────────────────────────
GRPC_PORT=9090
GRPC_GOOGLE_MAPS_SERVICE_ADDR=
GRPC_GOOGLE_MAPS_SERVICE_PORT=9091

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=console
